# Copy to .env for local development. Never put real credentials in this file.
APP_ENV=development
DATABASE_PATH=data/classroom_quiz.sqlite3
SESSION_TTL_SECONDS=300
# Repo-relative path to a local Google Service Account JSON key file.
# Keep the actual JSON file ignored under credential/; never copy its contents here.
GOOGLE_SERVICE_ACCOUNT_FILE=credential/service-account.json
